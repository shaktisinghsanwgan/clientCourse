generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PRIMARY
  PARTNER
}

enum PaymentStatus {
  PENDING
  PAID
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PartnerStatus {
  PENDING
  ACTIVE
}

enum RatingSubmissionStatus {
  DRAFT
  SUBMITTED
}

model User {
  id                        BigInt        @id @default(autoincrement())
  kajabiUserId              String?       @unique @map("kajabi_user_id") @db.VarChar(255)
  name                      String        @db.VarChar(150)
  email                     String        @unique @db.VarChar(255)
  role                      UserRole
  paymentStatus             PaymentStatus @default(PENDING) @map("payment_status")
  status                    UserStatus    @default(ACTIVE)
  emailVerified             Boolean       @default(false) @map("email_verified")
  purchaseReference         String?       @map("purchase_reference") @db.VarChar(255)
  offerReference            String?       @map("offer_reference") @db.VarChar(255)
  paymentVerificationSource String?       @map("payment_verification_source") @db.VarChar(50)
  paymentVerifiedAt         DateTime?     @map("payment_verified_at")
  lastActivityAt            DateTime      @default(now()) @map("last_activity_at")
  lastSeenAt                DateTime      @default(now()) @map("last_seen_at")
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @default(now()) @map("updated_at")

  primaryPartnership      Partner?                   @relation("PrimaryUser")
  partnerPartnership      Partner?                   @relation("PartnerUser")
  progress                Progress[]
  chapterProgress         ChapterProgress[]
  inactivityNotices       InactivityNotice[]
  partnerInviteNotice     PartnerInviteNotice?
  portalAccess            PortalAccess?
  weeklyRatings           WeeklyRating[]
  worksheetFiles          WorksheetFile[]
  checklistCompletions    ChecklistCompletion[]
  weeklyWorksheetProgress WeeklyWorksheetProgress[]

  @@index([role])
  @@index([paymentStatus])
  @@index([status, lastActivityAt])
  @@map("users")
}

model Partner {
  id            BigInt        @id @default(autoincrement())
  primaryUserId BigInt        @unique @map("primary_user_id")
  partnerUserId BigInt?       @unique @map("partner_user_id")
  partnerName   String        @map("partner_name") @db.VarChar(150)
  partnerEmail  String        @unique @map("partner_email") @db.VarChar(255)
  status        PartnerStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @default(now()) @map("updated_at")

  primaryUser User  @relation("PrimaryUser", fields: [primaryUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partnerUser User? @relation("PartnerUser", fields: [partnerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status])
  @@map("partners")
}

model CourseChapter {
  id           BigInt   @id @default(autoincrement())
  weekNumber   Int      @map("week_number")
  chapterId    String   @unique @map("chapter_id") @db.VarChar(100)
  chapterName  String   @map("chapter_name") @db.VarChar(255)
  chapterOrder Int      @map("chapter_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @default(now()) @map("updated_at")

  chapterProgress ChapterProgress[]

  @@index([weekNumber, isActive])
  @@map("course_chapters")
}

model Progress {
  id                 BigInt   @id @default(autoincrement())
  userId             BigInt   @map("user_id")
  weekNumber         Int      @map("week_number")
  totalChapters      Int      @map("total_chapters")
  completedChapters  Int      @map("completed_chapters")
  progressPercentage Decimal  @map("progress_percentage") @db.Decimal(5, 2)
  completed          Boolean  @default(false)
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, weekNumber])
  @@index([weekNumber])
  @@map("progress")
}

model ChapterProgress {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  chapterId   String    @map("chapter_id") @db.VarChar(100)
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @default(now()) @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chapter CourseChapter @relation(fields: [chapterId], references: [chapterId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, chapterId])
  @@index([chapterId])
  @@map("chapter_progress")
}

model InactivityNotice {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  recipientEmail String   @map("recipient_email") @db.VarChar(255)
  lastActivityAt DateTime @map("last_activity_at")
  sentAt         DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, lastActivityAt])
  @@map("inactivity_notices")
}

model PartnerInviteNotice {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @unique @map("user_id")
  recipientEmail String   @map("recipient_email") @db.VarChar(255)
  sentAt         DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("partner_invite_notices")
}

model EmailConfirmation {
  id         BigInt    @id @default(autoincrement())
  email      String    @db.VarChar(255)
  codeHash   String    @map("code_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("email_confirmations")
}

model PortalAccess {
  id              BigInt    @id @default(autoincrement())
  userId          BigInt    @unique @map("user_id")
  programKey      String    @default("reignite-8-week") @map("program_key") @db.VarChar(64)
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  tokenEnc        String    @map("token_enc") @db.VarChar(255)
  kajabiContactId String?   @map("kajabi_contact_id") @db.VarChar(64)
  portalUrl       String?   @map("portal_url") @db.VarChar(512)
  kajabiSyncedAt  DateTime? @map("kajabi_synced_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("portal_access")
}

model WeeklyRating {
  id               BigInt                 @id @default(autoincrement())
  userId           BigInt                 @map("user_id")
  weekNumber       Int                    @map("week_number")
  desireRating     Int?                   @map("desire_rating")
  happinessRating  Int?                   @map("happiness_rating")
  connectionRating Int?                   @map("connection_rating")
  status           RatingSubmissionStatus @default(DRAFT)
  submittedAt      DateTime?              @map("submitted_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @default(now()) @map("updated_at")

  user      User                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revisions WeeklyRatingRevision[]

  @@unique([userId, weekNumber])
  @@index([weekNumber])
  @@map("weekly_ratings")
}

model WeeklyRatingRevision {
  id               BigInt                 @id @default(autoincrement())
  ratingId         BigInt                 @map("rating_id")
  desireRating     Int?                   @map("desire_rating")
  happinessRating  Int?                   @map("happiness_rating")
  connectionRating Int?                   @map("connection_rating")
  status           RatingSubmissionStatus
  createdAt        DateTime               @default(now()) @map("created_at")

  rating WeeklyRating @relation(fields: [ratingId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ratingId, createdAt])
  @@map("weekly_rating_revisions")
}

model WorksheetFile {
  id               BigInt    @id @default(autoincrement())
  userId           BigInt    @map("user_id")
  weekNumber       Int       @map("week_number")
  worksheetKey     String    @map("worksheet_key") @db.VarChar(80)
  originalFilename String    @map("original_filename") @db.VarChar(180)
  storagePath      String    @map("storage_path") @db.VarChar(255)
  mimeType         String    @map("mime_type") @db.VarChar(80)
  sizeBytes        Int       @map("size_bytes")
  active           Boolean   @default(true)
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  deletedAt        DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, weekNumber, worksheetKey, active])
  @@map("worksheet_files")
}

model ChecklistCompletion {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  weekNumber  Int       @map("week_number")
  itemKey     String    @map("item_key") @db.VarChar(80)
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, weekNumber, itemKey])
  @@index([weekNumber])
  @@map("checklist_completions")
}

model WeeklyWorksheetProgress {
  id                 BigInt    @id @default(autoincrement())
  userId             BigInt    @map("user_id")
  weekNumber         Int       @map("week_number")
  ratingsCompleted   Boolean   @default(false) @map("ratings_completed")
  checklistCompleted Boolean   @default(false) @map("checklist_completed")
  weekCompleted      Boolean   @default(false) @map("week_completed")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, weekNumber])
  @@index([weekNumber])
  @@map("weekly_worksheet_progress")
}
