PORT=5000
NODE_ENV=development

# Local Docker MySQL. On Railway, set DATABASE_URL to ${{MySQL.MYSQL_URL}}
# or leave it empty when MYSQL_URL is already present. The app also accepts
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, and MYSQLDATABASE.
DATABASE_URL="mysql://root:password@127.0.0.1:3307/kajabi_partner_course"

JWT_SECRET="replace_with_secure_secret"
JWT_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:3000"

# Official Kajabi Public API (Settings -> Security -> User API Keys).
# Leave blank when the connected Kajabi plan does not provide API access.
# The API will not be called, and purchases will stay PENDING.
KAJABI_API_BASE_URL=""
KAJABI_API_KEY=""
KAJABI_API_SECRET=""

# Optional site and offer filters from the Kajabi admin.
# KAJABI_API_KEY is the OAuth client_id. KAJABI_API_SECRET is the client_secret.
KAJABI_SITE_ID=""
KAJABI_OFFER_ID=""

# Optional overrides for the Kajabi contact fields already created in admin.
# Blank uses the field title, then these handles: Partner Email custom_5,
# Partner Name custom_6, Partner Id custom_7, Purchaser Name custom_8,
# Purchaser Id custom_9, Purchaser Email custom_10, Partner Signup Status custom_11.
KAJABI_CONTACT_FIELD_PARTNER_NAME=""
KAJABI_CONTACT_FIELD_PARTNER_ID=""
KAJABI_CONTACT_FIELD_PARTNER_EMAIL=""
KAJABI_CONTACT_FIELD_SIGNUP_STATUS=""
KAJABI_CONTACT_FIELD_PURCHASER_NAME=""
KAJABI_CONTACT_FIELD_PURCHASER_ID=""
KAJABI_CONTACT_FIELD_PURCHASER_EMAIL=""

# Shared secret placed only in the server-side webhook target URL.
# Kajabi purchase webhooks are a signal. Payment is marked PAID only after
# the official API confirms an active purchase.
KAJABI_WEBHOOK_SECRET=""

ADMIN_API_KEY=""

# Email sent to CLIENT_EMAIL through Resend (https://resend.com). Leave any of
# RESEND_API_KEY, RESEND_FROM, or CLIENT_EMAIL empty to skip sending.
# RESEND_FROM must use a domain verified in Resend, for example
# Reignite <notifications@reignitesex.com>
# 1. A purchaser or partner has no course activity for more than INACTIVITY_DAYS.
# 2. A purchaser still has not invited a partner. The first email goes as soon as
#    they register, and again every PARTNER_INVITE_REMINDER_HOURS until they invite someone.
RESEND_API_KEY=""
RESEND_FROM=""
CLIENT_EMAIL=""
INACTIVITY_DAYS=7
PARTNER_INVITE_REMINDER_HOURS=48
# Minute 15 of every hour. The API process runs this schedule for both emails.
INACTIVITY_CRON="15 * * * *"
# A status poll newer than this many minutes counts as live.
STATUS_LIVE_MINUTES=2
