PORT=5000
NODE_ENV=development

# Local Docker MySQL. On Railway, set DATABASE_URL to ${{MySQL.MYSQL_URL}}
# or leave it empty when MYSQL_URL is already present. The app also accepts
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, and MYSQLDATABASE.
DATABASE_URL="mysql://root:password@127.0.0.1:3307/kajabi_partner_course"

JWT_SECRET="replace_with_secure_secret"
JWT_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:3000"

# Official Kajabi Public API (Settings -> Security -> User API Keys).
# Leave blank when the connected Kajabi plan does not provide API access.
# The API will not be called, and purchases will stay PENDING.
KAJABI_API_BASE_URL=""
KAJABI_API_KEY=""
KAJABI_API_SECRET=""

# Optional site and offer filters from the Kajabi admin.
# KAJABI_API_KEY is the OAuth client_id. KAJABI_API_SECRET is the client_secret.
KAJABI_SITE_ID=""
KAJABI_OFFER_ID=""

# Shared secret placed only in the server-side webhook target URL.
# Kajabi purchase webhooks are a signal. Payment is marked PAID only after
# the official API confirms an active purchase.
KAJABI_WEBHOOK_SECRET=""

ADMIN_API_KEY=""

# Email sent when a client has no course activity for more than INACTIVITY_DAYS.
# Leave SMTP_HOST empty to skip sending. The hourly check still runs.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_SECURE=false
INACTIVITY_DAYS=7
# Minute 15 of every hour. The API process runs this schedule.
INACTIVITY_CRON="15 * * * *"
# A status poll newer than this many minutes counts as live.
STATUS_LIVE_MINUTES=2
